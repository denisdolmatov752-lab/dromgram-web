NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://dromgram:your_password@localhost:5432/dromgram
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_change_this
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_minimum_64_characters_long_change
ENABLE_SMS=false
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=
FIREBASE_SERVICE_ACCOUNT=/root/TG-backend/firebase-service-account.json
MEDIA_PATH=/var/dromgram/media
MEDIA_URL=https://orproject.ru/media
CORS_ORIGINS=https://orproject.ru,http://localhost:3000,http://localhost:4001,http://localhost:4002
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
MAX_FILE_SIZE=52428800
BCRYPT_ROUNDS=12
OPENROUTER_KEY=sk-or-v1-placeholder
